{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git check-ignore*)",
      "Bash(python scripts/validate_project.py*)",
      "Bash(python scripts/security/check_secrets.py*)",
      "Bash(backend/.venv/Scripts/python -m pytest*)",
      "Bash(backend/.venv/Scripts/python -m ruff*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run test*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr close*)",
      "Bash(gh api*)",
      "Bash(npm install*)",
      "Bash(pip install*)",
      "Bash(*makeupar.com*)",
      "Bash(*yce-api*)",
      "Bash(*YOUCAM_MODE=live*)",
      "PowerShell(*makeupar.com*)",
      "PowerShell(*yce-api*)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.githooks/**)",
      "Edit(/scripts/security/**)",
      "Edit(/scripts/tests/test_security_guards.py)",
      "Edit(/scripts/validate_project.py)",
      "Edit(/.github/workflows/**)",
      "Edit(/.gitignore)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/*.env)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.staging)",
      "Edit(**/*.env)",
      "Edit(/.claude/settings.local.json)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py\" || exit 2",
            "onFailure": "block",
            "timeout": 15,
            "statusMessage": "GlowCue command guard"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_edits.py\" || exit 2",
            "onFailure": "block",
            "timeout": 15,
            "statusMessage": "GlowCue secret guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_python.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
