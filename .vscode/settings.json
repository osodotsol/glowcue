{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend", "${workspaceFolder}/scripts/security"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["backend/tests", "scripts/tests"],
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true, "**/.ruff_cache": true }
}
